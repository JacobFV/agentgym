# --- sponsor providers ---
# Subquadratic (https://console.subq.ai) — failure analysis (SubQ Snap 1.1 Decisions API)
SUBQ_API_KEY=
SUBQ_BASE_URL=https://api.subq.ai/v1
SUBQ_SNAP_MODEL=subq-snap-1.1
# optional: SubQ chat model (early access per org) for narrative diagnosis
SUBQ_CHAT_MODEL=subq-preview

# Meta Model API (https://dev.meta.ai) — mutation generator + coding agent
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Google Gemini — optional advisory verifier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- role routing (meta | subquadratic | gemini | claude-cli | none) ---
# claude-cli is a local DEV ADAPTER, never a sponsor. labeled as such in every log.
# CODER_PROVIDER=meta
# MUTATOR_PROVIDER=meta
# VERIFIER_PROVIDER=gemini
# ALLOW_DEV_FALLBACK=0

# --- harness ---
CONCURRENCY=6
REPS=1
